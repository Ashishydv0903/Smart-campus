# ==============================================================================
# SMART CAMPUS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the same folder and configure your real values:
# cp .env.example .env
# ==============================================================================

# Server Network Port
PORT=5000

# ------------------------------------------------------------------------------
# MONGODB CONNECTION STRING
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default)
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_db

# Option B: MongoDB Atlas Cloud Database (Recommended for Production / Deployment)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_campus_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECRET
# ------------------------------------------------------------------------------
# A strong, random secret key used to sign and verify JSON Web Tokens:
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# ------------------------------------------------------------------------------
# PLATFORM SUPER ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
# These credentials are used to bootstrap the platform administrator account.
# The server automatically hashes this password with bcrypt into MongoDB on startup.
# This account has cross-college oversight and multi-tenant domain authorization powers.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PRN=admin
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_DOMAIN=campus.edu

# ------------------------------------------------------------------------------
# OPTIONAL AI / LLM SERVICE KEYS
# ------------------------------------------------------------------------------
# If you wish to connect external AI services (e.g., Google Gemini API):
# GEMINI_API_KEY=your_gemini_api_key_here
