# ==============================================================================
# SMART CAMPUS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to 'server/.env' and configure your real credentials:
# cp .env.example server/.env
# ==============================================================================

# Server Network Port
PORT=5000

# ------------------------------------------------------------------------------
# MONGODB CONNECTION STRING
# ------------------------------------------------------------------------------
# Option A: Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_db

# Option B: MongoDB Atlas Cloud (Atlas Free Tier or Dedicated Cluster)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_campus_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECRET
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_smart_campus_jwt_token_key_2026

# ------------------------------------------------------------------------------
# PLATFORM SUPER ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PRN=admin
ADMIN_PASSWORD=Admin@SecurePass2026
ADMIN_DOMAIN=campus.edu

# ------------------------------------------------------------------------------
# OPTIONAL AI / LLM SERVICE KEYS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
